# Base de datos PostgreSQL (usando el driver pg8000)
DATABASE_URL="postgresql+pg8000://postgres:postgres@localhost:5432/hospital_db"

# Clave secreta para sesiones y firma de tokens JWT
SECRET_KEY=cambiar_por_una_clave_secreta_segura

# Configuración de la API REST y Portal Público
JWT_EXPIRATION_HOURS=12
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OAuth 2.0 / Google Identity Services (debe coincidir con VITE_GOOGLE_CLIENT_ID en portal/.env)
GOOGLE_CLIENT_ID=tu_client_id_aqui.apps.googleusercontent.com

# Configuración de Correo (Flask-Mail)
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USE_TLS=false
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@hospital.com
